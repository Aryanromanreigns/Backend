<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create User</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900">

  <div class="w-full h-screen bg-zinc-900 p-10 text-white">

    <!-- NAV -->
    <div class="nav mb-5">
      <a class="text-blue-500" href="/read">read</a>
    </div>

    <!-- HEADING -->
    <h1 class="text-3xl tracking-tighter mb-5">Create User</h1>

    <!-- FORM -->
    <form action="/create" method="post" class="flex gap-4">

      <input 
        class="px-5 py-2 border-2 border-zinc-800 bg-zinc-900 text-white outline-none rounded-md placeholder:text-zinc-500 focus:border-blue-500" 
        type="text" 
        name="name" 
        placeholder="name"
      >

      <input 
        class="px-5 py-2 border-2 border-zinc-800 bg-zinc-900 text-white outline-none rounded-md placeholder:text-zinc-500 focus:border-blue-500" 
        type="email" 
        name="email" 
        placeholder="email"
      >

      <input 
        class="px-5 py-2 border-2 border-zinc-800 bg-zinc-900 text-white outline-none rounded-md placeholder:text-zinc-500 focus:border-blue-500" 
        type="text" 
        name="image" 
        placeholder="image url"
      >

      <input 
        class="px-5 py-2 bg-blue-500 rounded-md hover:bg-blue-600 cursor-pointer transition" 
        type="submit" 
        value="Create User"
      >

    </form>

  </div>

</body>
</html>
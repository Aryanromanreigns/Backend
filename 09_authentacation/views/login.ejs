<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create User</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>

  <div class="w-full h-screen bg-zinc-900 text-white p-10">
    
    <h3 class="text-3xl mb-6">login your account</h3>

    <form method="post" action="/login" class="flex gap-4 items-center">
      
      <!-- <input 
        type="text" 
        name="username"
        placeholder="username"
        class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-700 outline-none"
      > -->

      <input 
        type="email" 
        name="email"
        placeholder="email"
        class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-700 outline-none"
      >

      <input 
        type="password" 
        name="password"
        placeholder="password"
        class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-700 outline-none"
      >

      <!-- <input 
        type="number" 
        name="age"
        placeholder="age"
        class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-700 outline-none"
      > -->

      <button 
        type="submit"
        class="px-5 py-2 rounded-md bg-blue-500 hover:bg-blue-600 transition"
      >
        login
      </button>

    </form>

  </div>

</body>
</html>